<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ocean_background"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Секция профиля (Редактируемая) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/ocean_card"
                app:strokeColor="@color/ocean_primary"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:animateLayoutChanges="true"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/btn_toggle_profile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/tv_profile_header"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ваш профиль"
                            android:textColor="@color/ocean_text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:layout_centerVertical="true"
                            android:layout_centerHorizontal="true"/>

                        <ImageView
                            android:id="@+id/iv_profile_arrow"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@android:drawable/ic_menu_more"
                            app:tint="@color/ocean_primary"
                            android:contentDescription="Развернуть профиль" />
                    </RelativeLayout>

                    <!-- Выезжающая часть профиля -->
                    <LinearLayout
                        android:id="@+id/layout_profile_expandable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="16dp"
                        tools:visibility="visible">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_edit_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Только просмотр"
                            android:textColor="@color/ocean_text_secondary"
                            android:layout_marginBottom="16dp"
                            app:thumbTint="@color/anchor_gold"
                            app:trackTint="@color/ocean_text_secondary" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_profile_name"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Наименование / ФИО"
                            app:boxStrokeColor="@color/ocean_primary"
                            app:errorEnabled="true">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_profile_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ocean_text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_profile_phone"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:hint="@string/hint_phone"
                            app:boxStrokeColor="@color/ocean_primary"
                            app:errorEnabled="true">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_profile_phone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:importantForAutofill="no"
                                android:inputType="phone"
                                android:textColor="@color/ocean_text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:id="@+id/layout_profile_legal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_profile_legal_form"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:hint="@string/hint_legal_form"
                                app:boxStrokeColor="@color/ocean_primary"
                                app:errorEnabled="true">
                                <AutoCompleteTextView
                                    android:id="@+id/actv_profile_legal_form"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"
                                    tools:ignore="LabelFor" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_profile_inn"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:hint="ИНН"
                                app:boxStrokeColor="@color/ocean_primary"
                                app:errorEnabled="true">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_profile_inn"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:importantForAutofill="no"
                                    android:inputType="number"
                                    android:textColor="@color/ocean_text_primary" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_profile_kpp"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:hint="КПП"
                                app:boxStrokeColor="@color/ocean_primary"
                                app:errorEnabled="true">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_profile_kpp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:importantForAutofill="no"
                                    android:inputType="number"
                                    android:maxLength="9"
                                    android:textColor="@color/ocean_text_primary" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_profile_legal_address"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:hint="Юридический адрес"
                                app:boxStrokeColor="@color/ocean_primary"
                                app:errorEnabled="true">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_profile_legal_address"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/ocean_text_primary" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_save_profile"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:layout_marginTop="20dp"
                            android:text="Сохранить"
                            android:textStyle="bold"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_show_change_password"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Сменить пароль"
                            android:textColor="@color/ocean_primary" />

                        <!-- Секция смены пароля (скрыта) -->
                        <LinearLayout
                            android:id="@+id/layout_change_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_old_password"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:hint="Старый пароль"
                                app:passwordToggleEnabled="true"
                                app:errorEnabled="true">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_old_password"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:importantForAutofill="no"
                                    android:inputType="textPassword" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_new_password"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:hint="Новый пароль"
                                app:passwordToggleEnabled="true"
                                app:errorEnabled="true">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_new_password"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:importantForAutofill="no"
                                    android:inputType="textPassword" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_confirm_password"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:hint="Подтвердите пароль"
                                app:passwordToggleEnabled="true"
                                app:errorEnabled="true">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_confirm_password"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:importantForAutofill="no"
                                    android:inputType="textPassword" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_confirm_password_change"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginTop="12dp"
                                android:text="Подтвердить смену"
                                app:cornerRadius="10dp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_delete_account"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Удалить аккаунт"
                            android:textColor="@color/signal_red" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_logout"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="24dp"
                            android:text="Выйти из системы"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            app:backgroundTint="@color/signal_red"
                            app:cornerRadius="12dp" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_orders_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="История заказов"
                android:textColor="@color/ocean_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_profile" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_orders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/tv_orders_header"
                tools:listitem="@layout/item_order" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
